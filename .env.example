# YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=your_api_key_here

# Secret protecting the MCP endpoint. Generate one with: openssl rand -hex 32
# The connector URL becomes https://<DOMAIN>/mcp/<MCP_AUTH_TOKEN>
MCP_AUTH_TOKEN=change_me

# Domain pointing to your VPS (DNS A record), used by Caddy for HTTPS
DOMAIN=youtube-mcp.example.com

# Optional: request timeout for YouTube APIs, in milliseconds
# YOUTUBE_TIMEOUT=30000
